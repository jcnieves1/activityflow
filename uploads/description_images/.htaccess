# Uploaded images are re-encoded through GD before being saved (see
# process_description_image_upload() in includes/models/description_images.php)
# and always written with a generated .jpg/.png filename, so nothing here
# should ever be a script — this is defense in depth in case a misconfigured
# server ever tries to execute a file in this folder anyway.
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<FilesMatch "\.(php|phtml|php[0-9]|phar)$">
    Require all denied
</FilesMatch>
Options -ExecCGI
AddType text/plain .php .phtml .phar
